{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "www",
    "jsx": "react"
  },
  "include": ["*.ts", "*.tsx"],
  "exclude": ["www"]
}
